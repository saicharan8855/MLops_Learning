*.so
.Python
build/
dist/
*.egg-info/
*.egg
venv/
.venv/
ENV/
env/
.env

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebooks
.ipynb_checkpoints/

